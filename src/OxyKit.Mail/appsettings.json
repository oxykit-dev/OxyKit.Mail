{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ],
    "AllowCredentials": true
  },
  "QueueSettings": {
    "PollIntervalSeconds": 10,
    "BatchSize": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailSenderSettings": {
    "MaxRetries": 3,
    "DelayMs": 2000
  },
  "RateLimit": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 5
    },
    "Email": {
      "PermitLimit": 50,
      "WindowSeconds": 60,
      "QueueLimit": 10
    },
    "Api": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 10
    }
  },
  "RequestLimits": {
    "MaxRequestBodySize": 10485760,
    "MaxEmailBodySize": 5242880,
    "MaxAttachmentSize": 5242880
  },
  "ApiKeySettings": {
    "MaxAgeInDays": 90,
    "WarnBeforeExpiryDays": 14,
    "MaxInactiveTimeInDays": 30
  },
  "AllowedHosts": "*"
}