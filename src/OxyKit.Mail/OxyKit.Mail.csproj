<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="ErrorOr" Version="2.1.1" />
    <PackageReference Include="FastEndpoints" Version="8.3.0" />
    <PackageReference Include="FastEndpoints.Security" Version="8.3.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.3.0" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    <!-- MimeKit/MailKit transitively pull vulnerable Pkcs ≤10.0.12 (GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Update=".env">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="OxyKit.Mail.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OxyKit.Mail.Contracts\OxyKit.Mail.Contracts.csproj" />
    <ProjectReference Include="..\OxyKit.Mail.Infrastructure.Postgres\OxyKit.Mail.Infrastructure.Postgres.csproj" />
    <ProjectReference Include="..\OxyKit.Mail.Infrastructure.Sqlite\OxyKit.Mail.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="..\OxyKit.Mail.Infrastructure.SqlServer\OxyKit.Mail.Infrastructure.SqlServer.csproj" />
    <ProjectReference Include="..\OxyKit.Mail.Infrastructure\OxyKit.Mail.Infrastructure.csproj" />
  </ItemGroup>
</Project>
