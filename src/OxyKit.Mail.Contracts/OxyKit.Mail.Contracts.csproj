<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Modern .NET only. Framework 2.0/4.5+: docs/DOTNET_FRAMEWORK_INTEGRATION.md (raw HTTP). -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OxyKit.Mail.Contracts</RootNamespace>
    <Description>Shared send request/response contracts for OxyKit.Mail (API key / integrator surface).</Description>
    <PackageId>OxyKit.Mail.Contracts</PackageId>
    <Version>0.1.5</Version>
    <Authors>OxyKit.Mail</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://oxykit.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/oxykit-dev/OxyKit.Mail</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>oxykit;mail;contracts</PackageTags>
    <PackageIcon>images/icon.png</PackageIcon>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\OxyKit.Mail.Contracts.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\docs\nuget\icon.png" Pack="true" PackagePath="images/" />
  </ItemGroup>
</Project>
